# Anonymous Mode
# TRUE disables authentication, presence and analytics, so the apps run with
# no backend at all. This is the right setting for local development and for
# public demo deployments. Set it to FALSE (or blank) and fill in the Supabase
# and GitHub values below to run against a real backend.
PUBLIC_ANON_MODE=TRUE

# Supabase Configuration (ignored while PUBLIC_ANON_MODE=TRUE)
# Get these from your Supabase project settings → API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# GitHub OAuth (reader app only; ignored while PUBLIC_ANON_MODE=TRUE)
# Create a GitHub OAuth App at https://github.com/settings/developers
PRIVATE_AUTH_GITHUB_ID=your-github-oauth-app-id
PRIVATE_AUTH_GITHUB_SECRET=your-github-oauth-app-secret

# Auth.js Session Secret (reader app only)
# Must be at least 32 characters. Generate with: openssl rand -base64 32
PRIVATE_AUTH_SECRET=your-secret-key-at-least-32-chars-long

# Adobe PDF Embed API key (for TalkAdobe component)
PUBLIC_PDF_KEY=your-adobe-pdf-key

# Moodle web-service endpoint (time app only)
MOODLE_WS_URL=https://your-moodle.example.com/webservice/rest/server.php
MOODLE_WS_TOKEN=your-moodle-ws-token
MOODLE_WS_REST_FORMAT=json

# Moodle sync interval in minutes (time app only)
SYNC_INTERVAL_MINUTES=60

# Server log verbosity: debug | info | warn | error (all apps)
# Defaults to info in production and debug in dev. Logs are JSON lines in production.
LOG_LEVEL=

# Release harness only: freezes the server clock used for response and record
# timestamps at one ISO 8601 instant, so two stacks answer identical bytes.
# Never set this in a real deployment; the apps log a warning at startup and
# GET /version reports "clock": "frozen" while it is set. Left commented out on
# purpose (this file is also the container smoke test's env file).
# HARNESS_NOW=2026-09-16T09:05:00.000Z

# Prometheus scrape token (all apps). When set, GET /metrics requires
# "Authorization: Bearer <token>"; leave empty to keep the endpoint open.
METRICS_TOKEN=
