# Supabase Configuration
# Get these from your Supabase project settings → API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Anonymous Mode
# Set to "TRUE" to disable authentication and analytics entirely
# Useful for local development or public demo deployments
# PUBLIC_ANON_MODE=TRUE

# PartyKit Configuration
# URL of your PartyKit server for real-time presence features
# Set to "XXX" to disable real-time features
PUBLIC_party_kit_main_room=your-partykit-server.partykit.dev

# GitHub OAuth (reader app only)
# Create a GitHub OAuth App at https://github.com/settings/developers
PRIVATE_AUTH_GITHUB_ID=your-github-oauth-app-id
PRIVATE_AUTH_GITHUB_SECRET=your-github-oauth-app-secret

# Auth.js Session Secret (reader app only)
# Generate with: openssl rand -base64 32
PRIVATE_AUTH_SECRET=your-random-session-secret
