# https://editorconfig.org. Matches .prettierrc and the deno fmt settings in deno.json.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing double spaces are hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
