{
  "nodeModulesDir": "auto",
  "workspace": [
    "./packages/domain",
    "./packages/application",
    "./packages/adapters/driven/render-markdown",
    "./packages/jsr/tutors",
    "./packages/jsr/tutors-lite",
    "./packages/jsr/model",
    "./packages/jsr/gen",
    "./packages/jsr/time",
    "./packages/jsr/create",
    "./packages/jsr/types",
    "./packages/jsr/identity"
  ],
  "fmt": {
    "include": [
      "./packages/domain/src/",
      "./packages/application/src/",
      "./packages/adapters/driven/render-markdown/src/",
      "./packages/jsr/gen/src/",
      "./packages/jsr/model/src/",
      "./packages/jsr/tutors/",
      "./packages/jsr/tutors-lite/",
      "./packages/jsr/types/",
      "./packages/jsr/identity/"
    ],
    "useTabs": false,
    "lineWidth": 180,
    "indentWidth": 2,
    "singleQuote": false
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "publish": "deno publish",
    "publish-test": "deno publish --dry-run"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
