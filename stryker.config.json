{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "packageManager": "pnpm",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mutation.ts"
  },
  "mutate": [
    "packages/domain/src/course/services/search.ts",
    "packages/domain/src/course/utils/lo-utils.ts",
    "packages/domain/src/course/types/type-utils.ts",
    "packages/domain/src/learning/services/base-calendar-model.ts",
    "packages/domain/src/learning/utils/calendar-utils.ts",
    "packages/domain/src/course/services/lo-tree.ts",
    "packages/domain/src/course/utils/course-utils.ts",
    "packages/adapters/driven/render-markdown/src/markdown-utils.ts",
    "packages/domain/src/learning/services/base-lab-model.ts",
    "packages/domain/src/learning/utils/lab-utils.ts",
    "packages/jsr/gen/src/utils/lr-utils.ts",
    "packages/jsr/gen/src/templates/utils.ts",
    "packages/jsr/gen/src/services/course-builder.ts",
    "packages/jsr/gen/src/services/resource-builder.ts"
  ],
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 90
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ObjectLiteral"
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".svelte-kit",
    "reports",
    ".stryker-tmp*"
  ],
  "checkers": [],
  "disableTypeChecks": "{packages/**/*.ts,tests/**/*.ts}"
}
