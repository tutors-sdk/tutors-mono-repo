{
  "name": "tutors-mono-repo",
  "version": "16.2.2",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Tutors monorepo - educational course reader platform",
  "scripts": {
    "dev": "pnpm --filter @tutors/ui-primitives build && pnpm --filter @tutors/ui-navigators build && pnpm --filter @tutors/ui-components build && pnpm --filter tutors-reader dev",
    "dev:reader": "pnpm --filter @tutors/ui-primitives build && pnpm --filter @tutors/ui-navigators build && pnpm --filter @tutors/ui-components build && pnpm --filter tutors-reader dev",
    "build": "pnpm --filter tutors-reader... build",
    "check": "pnpm --filter tutors-reader --filter tutors-catalogue --filter tutors-live check",
    "generate:okf": "tsx scripts/generate-okf.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "vitest run --config vitest.config.ts tests/bdd/",
    "test:contract": "vitest run tests/contract/",
    "test:fuzz": "vitest run --config vitest.config.fuzz.ts",
    "test:tz": "tsx scripts/checks/tz-matrix.ts",
    "test:mutation": "npx stryker run",
    "test:e2e": "pnpm test:e2e:reader && pnpm test:e2e:catalogue && pnpm test:e2e:live",
    "test:e2e:reader": "playwright test --config apps/reader/playwright.config.ts",
    "test:e2e:catalogue": "playwright test --config apps/catalogue/playwright.config.ts",
    "test:e2e:live": "playwright test --config apps/live/playwright.config.ts",
    "test:a11y": "playwright test --config=playwright-a11y.config.ts",
    "e2e:stack:fixture": "deno run -A --no-lock tests/e2e-stack/fixture-course/build.ts",
    "e2e:stack:up": "docker compose -f tests/e2e-stack/compose.yaml up -d --wait",
    "e2e:stack:down": "docker compose -f tests/e2e-stack/compose.yaml down",
    "test:e2e:stack": "playwright test --config playwright.e2e-stack.config.ts",
    "test:e2e:stack:ratchet": "node tests/e2e-stack/ratchet.mjs",
    "test:runway": "vitest run tests/architecture tests/suite-health tests/completeness tests/observability tests/conformance tests/security tests/performance",
    "check:all": "pnpm run check && pnpm run test && pnpm run test:contract && pnpm run build",
    "lint": "eslint .",
    "api-report": "tsx scripts/api-surface.ts",
    "api-report:check": "tsx scripts/api-surface.ts --check",
    "architecture-report": "depcruise apps packages --config .dependency-cruiser.cjs --output-type err-long",
    "check:k8s": "tsx scripts/checks/k8s-conformance.ts",
    "check:container": "tsx scripts/checks/container-smoke.ts",
    "check:test-time": "tsx scripts/checks/test-time-budget.ts",
    "check:knip": "tsx scripts/checks/knip.ts",
    "check:audit": "tsx scripts/checks/dependency-audit.ts",
    "check:bundle": "tsx scripts/checks/bundle-budget.ts",
    "check:load": "tsx scripts/checks/load-test.ts",
    "check:lighthouse": "tsx scripts/checks/lighthouse.ts",
    "check:generator-diff": "tsx scripts/checks/generator-diff.ts",
    "check:release-claims": "tsx scripts/checks/release-claims.ts"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "7.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^4.1.11",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "esm-env": "^1.2.2",
    "fast-check": "^4.10.1",
    "front-matter": "^4.0.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "js-yaml": "^4.1.1",
    "knip": "6.36.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  }
}
