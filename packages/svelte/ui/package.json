{
  "name": "@tutors/ui",
  "version": "0.0.1",
  "description": "Shared Svelte UI components for Tutors",
  "private": true,
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": "./src/lib/components/*",
    "./navigators/*": "./src/lib/navigators/*",
    "./learning-objects/layout/*": "./src/lib/learning-objects/layout/*",
    "./learning-objects/content/*": "./src/lib/learning-objects/content/*",
    "./learning-objects/structure/*": "./src/lib/learning-objects/structure/*",
    "./time/*": "./src/lib/time/*",
    "./utils/sanitize": "./src/lib/utils/sanitize.ts",
    "./TutorsShell.svelte": "./src/lib/TutorsShell.svelte",
    "./styles.css": "./dist/style.css"
  },
  "scripts": {
    "build": "svelte-package -o dist && vite build --config vite.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tutors/logger": "workspace:*",
    "@tutors/runes": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@tutors/a11y": "workspace:*",
    "@tutors/community": "workspace:*",
    "@tutors/connect": "workspace:*",
    "@tutors/i18n": "workspace:*",
    "@tutors/course": "workspace:*",
    "@tutors/themes": "workspace:*",
    "@tutors/tutors-model-lib": "workspace:*",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "file-saver": "^2.0.5",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@iconify/svelte": "^5.2.1",
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  }
}
