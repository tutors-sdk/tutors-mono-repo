{
  "name": "@tutors/ui-primitives",
  "version": "0.0.1",
  "description": "Primitive Svelte UI components for Tutors (Icon, Menu, Sidebar, Image)",
  "private": true,
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": "./src/components/*",
    "./utils/*": "./src/utils/*"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tutors/a11y": "workspace:*",
    "@tutors/community": "workspace:*",
    "@tutors/i18n": "workspace:*",
    "@tutors/runes": "workspace:*",
    "@tutors/themes": "workspace:*",
    "@tutors/tutors-model-lib": "workspace:*",
    "dompurify": "^3.4.12"
  },
  "devDependencies": {
    "@iconify/svelte": "^5.2.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
