{
  "name": "@tutors/ui-components",
  "version": "0.0.1",
  "license": "MIT",
  "description": "High-level Svelte UI components for Tutors (navigators, learning objects, time views)",
  "private": true,
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./learning-objects/layout/*": "./src/learning-objects/layout/*",
    "./learning-objects/content/*": "./src/learning-objects/content/*",
    "./learning-objects/structure/*": "./src/learning-objects/structure/*",
    "./time/*": "./src/time/*",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && vite build --config vite.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@tutors/a11y": "workspace:*",
    "@tutors/community": "workspace:*",
    "@tutors/rbac": "workspace:*",
    "@tutors/connect": "workspace:*",
    "@tutors/course": "workspace:*",
    "@tutors/i18n": "workspace:*",
    "@tutors/logger": "workspace:*",
    "@tutors/runes": "workspace:*",
    "@tutors/themes": "workspace:*",
    "@tutors/tutors-model-lib": "workspace:*",
    "@tutors/ui-navigators": "workspace:*",
    "@tutors/ui-primitives": "workspace:*",
    "codemirror": "^6.0.2",
    "isomorphic-dompurify": "^2.21.0",
    "file-saver": "^2.0.5",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@iconify/svelte": "^5.2.1",
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  }
}
