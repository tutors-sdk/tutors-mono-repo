# Tutors Staging Environment
# Copy to .env and fill in values

# --- Image tag (default: latest) ---
IMAGE_TAG=latest

# --- Supabase ---
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Anonymous Mode ---
PUBLIC_ANON_MODE=

# --- GitHub OAuth (reader only) ---
PRIVATE_AUTH_GITHUB_ID=
PRIVATE_AUTH_GITHUB_SECRET=
PRIVATE_AUTH_SECRET=

# --- Adobe PDF ---
PUBLIC_PDF_KEY=

# --- Moodle (time app only) ---
SYNC_INTERVAL_MINUTES=60

# --- App Origins (for CORS/CSRF) ---
READER_ORIGIN=http://localhost:3000
CATALOGUE_ORIGIN=http://localhost:3001
LIVE_ORIGIN=http://localhost:3002
TIME_ORIGIN=http://localhost:3003

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme
