# Tutors staging environment. Copy to .env and fill in the values.
# The application variables are the same ones documented in the repo-root
# .env.example and deploy/README.md; the stack-specific ones are at the top.

# --- Stack ---
# Image tag published by the image-build workflow:
#   main | latest | X.Y.Z | X.Y.Z-rc.N | rc-<branch> | sha-<short>
IMAGE_TAG=main

# Host ports (the containers always listen on 3000)
READER_PORT=3000
CATALOGUE_PORT=3001
LIVE_PORT=3002
TIME_PORT=3003

# Public URL of each app as users reach it (scheme, host and port).
READER_ORIGIN=http://localhost:3000
CATALOGUE_ORIGIN=http://localhost:3001
LIVE_ORIGIN=http://localhost:3002
TIME_ORIGIN=http://localhost:3003

# --- Supabase ---
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Anonymous mode: TRUE disables authentication and analytics ---
PUBLIC_ANON_MODE=

# --- GitHub OAuth and Auth.js session secret (reader only) ---
PRIVATE_AUTH_GITHUB_ID=
PRIVATE_AUTH_GITHUB_SECRET=
# At least 32 characters: openssl rand -base64 32
PRIVATE_AUTH_SECRET=

# --- Server-side data access (see the repo-root .env.example) ---
# Supabase service_role key: reader /api routes and the time app's Moodle sync. A secret.
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=
# Reader: origins that may read /api/time with the reader's cookie (the time app).
PRIVATE_API_ALLOWED_ORIGINS=http://localhost:3003
PRIVATE_TUTORS_ADMINS=
PRIVATE_COURSE_HOSTS=
# Time: the reader it reads course time data from.
PUBLIC_READER_URL=http://localhost:3000

# --- Adobe PDF Embed API key ---
PUBLIC_PDF_KEY=

# --- Moodle sync (time only) ---
MOODLE_WS_URL=
MOODLE_WS_TOKEN=
PRIVATE_MOODLE_SYNC_TOKEN=
MOODLE_WS_REST_FORMAT=json
SYNC_INTERVAL_MINUTES=60

# --- Logging: debug | info | warn | error ---
LOG_LEVEL=info
