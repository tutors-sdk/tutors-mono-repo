# Optional secret every app reads through `envFrom` (see deployment.yaml).
# The overlay prefixes the name, so create one per app: replace "reader" with
# catalogue, live or time. The time app has its own example with Moodle keys.
# Copy to secrets.yaml (git-ignored), fill in, then:
#   oc apply -f deploy/k8s/base/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: reader-tutors-app-secrets
type: Opaque
stringData:
  # When set, GET /metrics requires "Authorization: Bearer <token>".
  METRICS_TOKEN: ""
