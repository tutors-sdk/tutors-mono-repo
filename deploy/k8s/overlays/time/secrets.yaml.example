# Copy to secrets.yaml (git-ignored), fill in, then:
#   oc apply -f deploy/k8s/overlays/time/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: time-tutors-app-secrets
type: Opaque
stringData:
  # Moodle web-service token for the assignment sync.
  MOODLE_WS_TOKEN: ""
  # Required to call the operator-only POST /api/sync endpoint.
  PRIVATE_MOODLE_SYNC_TOKEN: ""
  # When set, GET /metrics requires "Authorization: Bearer <token>".
  METRICS_TOKEN: ""
