# Copy to secrets.yaml (git-ignored), fill in, then:
#   oc apply -f deploy/k8s/overlays/reader/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: reader-tutors-app-oauth
type: Opaque
stringData:
  PRIVATE_AUTH_GITHUB_ID: ""
  PRIVATE_AUTH_GITHUB_SECRET: ""
  # At least 32 characters: openssl rand -base64 32
  PRIVATE_AUTH_SECRET: ""
  # Supabase service-role key (Settings → API): help requests and lecturer feedback are kept only with it.
  PRIVATE_SUPABASE_SERVICE_ROLE_KEY: ""
