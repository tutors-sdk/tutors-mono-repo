# Copy to `.env` (which is gitignored) and fill in.

# --- Grafana admin (first login) ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# --- Local Supabase (`supabase start`) ---
# Defaults match a standard local Supabase; usually no need to change these.
# host.docker.internal lets the Grafana container reach Supabase on your host.
LOCAL_DB_HOST=host.docker.internal
LOCAL_DB_PORT=54322
LOCAL_DB_NAME=postgres
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres

# --- Staging Supabase (remote) ---
# Use the Supabase connection pooler host from: Project Settings -> Database.
# Point at the read-only grafana_reader role (see sql/grafana_reader.sql), NOT
# the service_role. Leave STAGING_DB_HOST empty to disable the staging source.
STAGING_DB_HOST=
STAGING_DB_PORT=5432
STAGING_DB_NAME=postgres
STAGING_DB_USER=grafana_reader
STAGING_DB_PASSWORD=
STAGING_DB_SSLMODE=require
